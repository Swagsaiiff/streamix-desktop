# Copy to .env and fill in. Never commit .env or real keys.
# Server port (default 4000)
PORT=4000

# Optional TMDB metadata enrichment (Phase 1). Leave empty until the user provides a real key.
TMDB_API_KEY=

# FFmpeg/FFprobe executables (Phase 3). Defaults resolve from PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional path to a local multi-audio test fixture (generated by scripts/make-test-fixture.mjs).
# When set, /api/stream resolves playback from this fixture instead of a provider stream.
STREAMIX_FIXTURE=

# Preferred HLS audio language (e.g. en, hi). Used only when a track's real language metadata matches.
PREFERRED_AUDIO_LANGUAGE=en

# Allow the local test fixture to be played when no real provider source resolves (default: false).
# When false, Play returns a clear error instead of silently substituting test content.
STREAMIX_FIXTURE_FALLBACK=false

# Optional cap on HLS transcode length in seconds (0 = transcode the whole source).
STREAMIX_SESSION_MAX_SECONDS=0
