{
  "name": "streamix-desktop",
  "productName": "STREAMIX",
  "version": "1.0.0",
  "description": "Responsive streaming desktop application with native MPV playback",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "author": "STREAMIX Team",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "test:spike": "node src/spike-mpv.js",
    "prepackage": "node scripts/prepare-package.mjs",
    "package": "npm run prepackage && electron-builder --win nsis --x64",
    "postpackage": "node -e \"const fs=require('node:fs'), path=require('node:path'); const candidates = ['dist/STREAMIX Setup 1.0.0.exe', 'dist/STREAMIX.Setup.1.0.0.exe']; for (const c of candidates) { if (fs.existsSync(c)) { fs.copyFileSync(c, 'dist/setup.exe'); console.log('[postpackage] Created dist/setup.exe mirror from ' + c); break; } }\""
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.streamix.desktop",
    "productName": "STREAMIX",
    "electronVersion": "44.9.0",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "client-dist/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin/streamix-video-host.exe",
        "to": "streamix-video-host.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STREAMIX"
    }
  }
}
